# Copy this file to .env and fill in at least one provider key.
# API keys stay in .env. The web UI can choose among configured providers/models,
# but it never asks for or displays API key values.

# Default single-provider setup. These values are also the UI defaults.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional OpenAI-compatible provider. Set OPENAI_API_KEY to make this provider
# selectable in the Settings sidebar.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional mixed-role defaults. The UI may override these per game run.
# WORD_MASTER_PROVIDER=mistral
# PLAYER_A_PROVIDER=openai
# PLAYER_B_PROVIDER=openai
# WORD_MASTER_MODEL=mistral-medium-latest
# PLAYER_A_MODEL=gpt-4.1-mini
# PLAYER_B_MODEL=gpt-4.1-mini

# Local development ports.
BACKEND_PORT=8000
FRONTEND_PORT=5173

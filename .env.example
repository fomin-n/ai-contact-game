# Copy this file to .env and fill in at least one provider key.
# API keys stay in .env. The web UI can choose among configured providers/models,
# but it never asks for or displays API key values.

# Default single-provider setup. These values are also the UI defaults.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional OpenAI-compatible provider. Set OPENAI_API_KEY to make this provider
# selectable in the Settings sidebar.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional mixed-role defaults. The UI may override these per game run.
# WORD_MASTER_PROVIDER=mistral
# PLAYER_A_PROVIDER=openai
# PLAYER_B_PROVIDER=openai
# WORD_MASTER_MODEL=mistral-medium-latest
# PLAYER_A_MODEL=gpt-4.1-mini
# PLAYER_B_MODEL=gpt-4.1-mini

# Local development ports.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Telegram bot (required for bot mode).
AI_CONTACT_TELEGRAM_BOT_TOKEN=
AI_CONTACT_TELEGRAM_SESSION_TTL_SECONDS=3600
AI_CONTACT_TELEGRAM_MAX_INPUT_LENGTH=500
AI_CONTACT_TELEGRAM_ALLOWED_CHAT_TYPES=private
# Path to the access-code/authorized-users store (created automatically on first use).
AI_CONTACT_TELEGRAM_AUTH_DATA_PATH=data/auth.json

# Observability via Arize Phoenix (optional).
# Set to true when Phoenix is running (e.g. as a Docker container on the VPS).
# Access UI: ssh -L 6006:127.0.0.1:6006 user@host -N  →  http://localhost:6006
# Select project "ai-contact-game-bot" to see bot traces.
# Search by user: filter session.id = <telegram_user_id>
# Search by game: filter game.language or game.human_role attributes.
ENABLE_PHOENIX_TRACING=false
PHOENIX_PROJECT_NAME=ai-contact-game-bot
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
